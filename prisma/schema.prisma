generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Core auth table
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  role           Role
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  emailVerified  DateTime?
  lastLoginAt    DateTime?
  hasLoginAccess Boolean   @default(false)

  accounts Account[]
  sessions Session[]

  parent Parent?
  youth  Youth?
  staff  Staff?
}

model Parent {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName                      String
  lastName                       String
  phone                          String?
  dateOfBirth                    DateTime?
  gender                         Gender?
  maritalStatus                  MaritalStatus?
  employer                       String?
  employerPhone                  String?
  annualHouseholdIncome          String?
  hasHouseholdMembersOver65      Boolean?
  hasHouseholdMembersHandicapped Boolean?
  currentHeadOfHousehold         Gender?
  isCurrentSingleParent          YesNo?
  howManyInHousehold             String?
  howManyUnder18InHousehold      String?
  militaryBranch                 String?
  isHouseholdOnMilitaryBase      YesNo?

  addresses Address[]
  children  Youth[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Youth {
  id     String  @id @default(cuid())
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentId String
  parent   Parent @relation(fields: [parentId], references: [id])

  firstName   String
  lastName    String
  dateOfBirth DateTime
  gender      Gender?

  // Membership
  status         YouthStatus @default(ACTIVE)
  membershipType String?
  joinDate       DateTime    @default(now())

  // School
  school        String?
  schoolTeacher String?
  schoolGrade   String?

  // Demographics
  race      String?
  ethnicity String?

  // Permissions
  canAppearInMedia            Boolean? @default(false)
  canParticipateOnOffPremises Boolean? @default(false)

  // Special needs
  hasDisabilityIEP504      String?
  isEnglishLanguageLearner Boolean?

  // Program
  transportationPlan String?
  attendanceSchedule String?

  // Health
  physicalRecordsVerified  Boolean? @default(false)
  canAdministerCPRFirstAid Boolean?
  covidVaxStatus           String?
  canSwim                  Boolean?

  // Living situation
  livesWithMom          Boolean?
  livesWithDad          Boolean?
  livesWithGrandparents Boolean?
  livesWithStepmother   Boolean?
  livesWithStepfather   Boolean?
  livesWithFoster       Boolean?
  livesWithOther        String?
  isHomeless            Boolean?
  isInFosterCare        Boolean?

  requiresPGPickup Boolean?

  // Relationships
  enrollments ProgramEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([lastName, firstName])
}

model Staff {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  phone     String?

  // Employment
  position   String
  department String?
  hireDate   DateTime
  status     StaffStatus @default(ACTIVE)

  // Relationships
  programAssignments StaffAssignment[] // Changed from programs to programAssignments

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Address {
  id        String       @id @default(cuid())
  street    String
  city      String
  state     String
  zipCode   String
  country   String       @default("United States")
  type      AddressType?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Relation to Parent (not User)
  parentId String
  parent   Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)
}

model Newsletter {
  id                       String   @id @default(cuid())
  firstName                String   @db.VarChar(255)
  lastName                 String   @db.VarChar(255)
  email                    String   @unique @db.VarChar(255)
  agreedToPrivacyStatement Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model Log {
  id        String   @id @default(cuid())
  level     String
  message   String
  metadata  Json?
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id                   String      @id @default(cuid())
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  title                String
  description          String?
  category             String
  type                 String
  cost                 String?
  dresscode            String?
  date                 DateTime
  time                 String
  duration             String
  location             String
  maxAttendees         Int?
  attendees            Int?
  status               EventStatus @default(UPCOMING)
  featured             Boolean     @default(false)
  host                 String?
  requirements         String?
  materials            String?
  registrationUrl      String?
  meetingUrl           String?
  viewCount            Int         @default(0)
  clickCount           Int         @default(0)
  chapterId            String
  isPublic             Boolean     @default(true)
  requiresRSVP         Boolean     @default(false)
  registrationDeadline DateTime    @default(now())
}

model Program {
  id          String          @id @default(cuid())
  name        String
  description String?         @db.Text
  category    ProgramCategory
  status      ProgramStatus   @default(ACTIVE)

  // Capacity and enrollment
  capacity Int
  enrolled Int @default(0)
  waitlist Int @default(0)

  // Schedule
  startDate   DateTime
  endDate     DateTime
  schedule    String?  @db.Text // JSON string for recurring schedule
  meetingDays String? // e.g., "Monday, Wednesday, Friday"
  startTime   String? // e.g., "3:00 PM"
  endTime     String? // e.g., "5:00 PM"
  location    String?

  // Age requirements
  minAge Int
  maxAge Int

  // Pricing
  fee Decimal @db.Decimal(10, 2)

  // Relationships
  enrollments      ProgramEnrollment[]
  staffAssignments StaffAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([startDate])
}

model StaffAssignment {
  id String @id @default(cuid())

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  role      String? // e.g., "Lead Instructor", "Assistant", "Volunteer"
  isPrimary Boolean @default(false) // Mark one staff as primary contact

  assignedAt DateTime @default(now())

  @@unique([programId, staffId])
  @@index([programId])
  @@index([staffId])
}

model ProgramEnrollment {
  id String @id @default(cuid())

  // Youth and Program
  youthId   String
  youth     Youth   @relation(fields: [youthId], references: [id], onDelete: Cascade)
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  // Enrollment details
  status     EnrollmentStatus @default(PENDING)
  enrolledAt DateTime         @default(now())
  startDate  DateTime
  endDate    DateTime?

  // Payment
  paymentStatus PaymentStatus @default(PENDING)
  amountPaid    Decimal       @default(0) @db.Decimal(10, 2)

  // Emergency contact for this enrollment
  emergencyContact String?
  emergencyPhone   String?

  // Medical info
  medicalNotes String? @db.Text
  allergies    String? @db.Text
  medications  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([youthId, programId])
  @@index([status])
  @@index([paymentStatus])
}

enum MembershipStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
  REJECTED
  INITIAL_REVIEW
  BACKGROUND_CHECK
  FINAL_DECISION
  FLAGGED
}

enum NotificationType {
  APPLICATION_SUBMITTED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  NEW_MEMBER
  SYSTEM_ALERT
}

enum EventStatus {
  DRAFT
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
  POSTPONED
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
  DOMESTIC_PARTNERSHIP
  PREFER_NOT_TO_SAY
}

enum AddressType {
  HOME
  WORK
  BILLING
  SHIPPING
  OTHER
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
  OTHER
}

enum YesNo {
  YES
  NO
}

enum Role {
  PARENT
  YOUTH
  STAFF
  VOLUNTEER
  ADMIN
  SUPERUSER
}

enum ProgramCategory {
  SPORTS
  ARTS
  STEM
  LEADERSHIP
  ACADEMIC
  RECREATION
  SUMMER_CAMP
  AFTER_SCHOOL
  OTHER
}

enum ProgramStatus {
  ACTIVE
  DRAFT
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum YouthStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  GRADUATED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  DROPPED
  WAITLISTED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
  WAIVED
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}
