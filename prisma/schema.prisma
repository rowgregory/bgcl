generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  role        Role
  lastLoginAt DateTime?

  // Generic person info (optional)
  firstName String?
  lastName  String?
  phone     String?

  // Staff-only fields (optional)
  position    String?
  department  String?
  hireDate    DateTime?
  staffStatus StaffStatus?

  // Flexible user-specific data
  metadata Json? // ← Future-proof

  accounts Account[]
  sessions Session[]
  events   Event[]
  orders   Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Newsletter {
  id                       String   @id @default(cuid())
  firstName                String   @db.VarChar(255)
  lastName                 String   @db.VarChar(255)
  email                    String   @unique @db.VarChar(255)
  agreedToPrivacyStatement Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model Log {
  id        String   @id @default(cuid())
  level     String
  message   String
  metadata  Json?
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id                   String      @id @default(cuid())
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  title                String
  description          String?
  category             String
  type                 String
  dresscode            String?
  date                 DateTime
  time                 String
  duration             String
  location             String
  maxAttendees         Int?
  attendees            Int         @default(0)
  status               EventStatus @default(UPCOMING)
  featured             Boolean     @default(false)
  host                 String?
  requirements         String?
  materials            String?
  registrationUrl      String?
  meetingUrl           String?
  viewCount            Int         @default(0)
  clickCount           Int         @default(0)
  isPublic             Boolean     @default(true)
  requiresRSVP         Boolean     @default(false)
  registrationDeadline DateTime    @default(now())

  // Event-level settings
  allowMultipleTickets Boolean   @default(false) // Can user buy multiple ticket types
  salesStartDate       DateTime? // When tickets go on sale
  salesEndDate         DateTime? // When ticket sales close

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relations
  tickets Ticket[] // ← NEW: One event has many ticket types
  orders  Order[] // ← NEW: One event has many orders

  @@index([date])
  @@index([status])
  @@index([status, date])
  @@index([featured, status, date])
  @@index([isPublic, status, date])
  @@index([category, date])
  @@index([type, date])
  @@index([requiresRSVP, registrationDeadline])
  @@index([salesStartDate])
  @@index([salesEndDate])
}

model Ticket {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ticket details
  name        String // e.g., "Table of 12", "VIP Seat", "General Admission"
  description String? // e.g., "Includes premium seating and dinner"
  price       Float // Price in cents or dollars (e.g., 180000 cents = $1800)

  // Inventory management
  totalQuantity    Int // Total available (e.g., 12 tables)
  quantitySold     Int @default(0) // How many sold
  quantityReserved Int @default(0) // How many in pending carts

  // Ticket constraints
  minPerOrder Int  @default(1) // Minimum tickets per order
  maxPerOrder Int? // Maximum tickets per order (null = unlimited)

  // Ticket availability
  isAvailable    Boolean   @default(true) // Can be toggled on/off
  salesStartDate DateTime? // When this ticket type goes on sale
  salesEndDate   DateTime? // When this ticket type stops selling

  // Ticket metadata
  sortOrder        Int     @default(0) // Display order in ticket selection
  requiresApproval Boolean @default(false) // Admin must approve purchase

  // Relations
  eventId    String
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems OrderItem[] // ← Tickets purchased in orders

  @@index([eventId])
  @@index([eventId, isAvailable])
  @@index([eventId, salesStartDate])
  @@index([salesEndDate])
}

model Order {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Order details
  orderNumber String      @unique // Human-readable order number
  status      OrderStatus @default(PENDING)

  // Payment
  totalAmount     Float // Total cost
  paymentMethod   String? // "stripe", "paypal", "cash", etc.
  paymentIntentId String? // Stripe payment intent ID
  paidAt          DateTime? // When payment was completed

  // Customer info (denormalized for easy access)
  customerEmail String
  customerName  String
  customerPhone String?

  // Billing info
  billingAddress Json? // Store as JSON

  // Event info (denormalized)
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  // User info (nullable - guest checkout allowed)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Relations
  orderItems OrderItem[]

  @@index([orderNumber])
  @@index([status])
  @@index([eventId])
  @@index([userId])
  @@index([customerEmail])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Item details
  quantity     Int
  pricePerUnit Float // Price at time of purchase
  totalPrice   Float // quantity * pricePerUnit

  // Ticket info (denormalized for historical record)
  ticketName        String // Store name in case ticket is deleted
  ticketDescription String?

  // Relations
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  @@index([orderId])
  @@index([ticketId])
}

model Hero {
  id     String     @id @default(cuid())
  name   String
  status HeroStatus @default(DRAFT)

  // Layout & Height
  minHeight    String @default("screen") // screen, half, full
  actualHeight String @default("100vh")

  // Background
  backgroundType     String @default("gradient") // color, gradient, image, video
  backgroundColor    String @default("#0a0a0a")
  gradientFrom       String @default("#1e1b4b")
  gradientTo         String @default("#0f172a")
  backgroundImage    String @default("")
  backgroundVideo    String @default("")
  backgroundSize     String @default("cover") // cover, contain, auto
  backgroundPosition String @default("center") // center, top, bottom, left, right, top-left, top-right, bottom-left, bottom-right
  overlayOpacity     Float  @default(0.5)

  // Content
  title              String  @default("Welcome to Our Mission")
  titleColor         String  @default("#ffffff")
  titleGradientWord  String  @default("") // Word to gradient
  titleGradientFrom  String  @default("#6366f1") // Gradient start
  titleGradientTo    String  @default("#ec4899") // Gradient end
  titleUseGradient   Boolean @default(false) // Enable gradient
  titleLineHeight    String  @default("1.2")
  titleFontSize      String  @default("4rem")
  subtitle           String  @default("Join us in making a difference")
  subtitleColor      String  @default("#a3a3a3")
  subtitleLineHeight String  @default("1.5")
  subtitleFontSize   String  @default("1.5rem")

  // Animations
  titleAnimation          String @default("fade-up") // fade-up, fade-down, fade-left, fade-right, scale, bounce, none
  subtitleAnimation       String @default("fade-up")
  ctaAnimation            String @default("fade-up")
  floatingButtonAnimation String @default("pulse") // pulse, bounce, shake, none

  // Layout
  layout String @default("side-by-side") // side-by-side, stacked-center, stacked-left, stacked-right

  // CTA Button
  ctaText            String @default("Get Started")
  ctaLink            String @default("/")
  ctaBackgroundColor String @default("#6366f1")
  ctaTextColor       String @default("#ffffff")
  ctaBorderRadius    String @default("50")

  // Thermometer Widget
  showThermometer     Boolean @default(false)
  thermometerGoal     Int     @default(100000)
  thermometerCurrent  Int     @default(45000)
  thermometerColor    String  @default("#6366f1")
  thermometerPosition String  @default("right") // left, center, right

  // Countdown Widget
  showCountdown     Boolean @default(false)
  countdownDate     String  @default("2025-12-31")
  countdownLabel    String  @default("Event Starts In")
  countdownPosition String  @default("right") // left, center, right
  countdownColor    String  @default("#6366f1")

  // Growth Tree Widget
  showGrowthTree     Boolean @default(false)
  growthTreeCurrent  Int     @default(8234)
  growthTreeGoal     Int     @default(10000)
  growthTreeLabel    String  @default("Community Members")
  growthTreePosition String  @default("right") // left, center, right
  growthTreeColor    String  @default("#10b981")

  // Floating Button
  showFloatingButton         Boolean @default(false)
  floatingButtonText         String  @default("Get Help")
  floatingButtonPosition     String  @default("bottom-right") // top-left, top-right, bottom-left, bottom-right
  floatingButtonBgColor      String  @default("#6366f1")
  floatingButtonTextColor    String  @default("#ffffff")
  floatingButtonBorderRadius String  @default("50")
  floatingButtonAction       String  @default("modal") // internal, external, modal, drawer
  floatingButtonLink         String  @default("/contact")
  floatingButtonIcon         String  @default("chat") // none, arrow, phone, email, chat, info, help

  // Top Banner
  showTopBanner      Boolean @default(false)
  topBannerText      String  @default("Click here to learn about our Capital Campaign")
  topBannerHeight    String  @default("40")
  topBannerBgColor   String  @default("#6366f1")
  topBannerTextColor String  @default("#ffffff")
  topBannerFontSize  String  @default("0.875")
  topBannerBold      Boolean @default(false)
  topBannerLinkType  String  @default("none") // none, internal, external
  topBannerLink      String  @default("")

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
}

enum Role {
  STAFF
  VOLUNTEER
  ADMIN
  SUPERUSER
  SUPPORTER
}

enum HeroStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum NotificationType {
  APPLICATION_SUBMITTED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  NEW_MEMBER
  SYSTEM_ALERT
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
  POSTPONED
}

enum OrderStatus {
  PENDING // Cart/checkout in progress
  PROCESSING // Payment being processed
  CONFIRMED // Payment successful
  CANCELLED // Order cancelled
  REFUNDED // Order refunded
  FAILED // Payment failed
}
