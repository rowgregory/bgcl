generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  role        Role
  lastLoginAt DateTime?

  // Generic person info (optional)
  firstName String?
  lastName  String?
  phone     String?

  emailVerified DateTime?

  // Staff-only fields (optional)
  position    String?
  department  String?
  hireDate    DateTime?
  staffStatus StaffStatus?

  // Flexible user-specific data
  metadata Json? // ← Future-proof

  stripeCustomerId String?
  paymentMethods   PaymentMethod[]
  accounts         Account[]
  sessions         Session[]
  orders           Order[]
  address          Address?

  eventsAttended Event[] @relation("EventAttendees")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentMethod {
  id              String @id @default(cuid())
  stripePaymentId String @unique // stripe_pm_xxxxx

  cardholderName String?
  cardBrand      String // visa, mastercard, etc
  cardLast4      String // 4242
  cardExpMonth   Int
  cardExpYear    Int

  isDefault Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Subscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  type         String // 'member', 'non-member', 'donor'
  subscribedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Log {
  id        String   @id @default(cuid())
  level     String
  message   String
  metadata  Json?
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Classification
  type     EventType   @default(IN_PERSON)
  status   EventStatus @default(UPCOMING)
  category String

  isPublic Boolean @default(true)

  // Details
  title        String
  description  String?
  host         String?
  dresscode    String?
  requirements String?
  materials    String?

  // Scheduling
  date     DateTime
  duration String
  order    Int      @default(0)

  // Location / access
  location        String
  meetingUrl      String?
  registrationUrl String?

  // Capacity
  capacity      Int  @default(200)
  maxAttendees  Int?
  attendeeCount Int  @default(0)

  // RSVP
  requiresRSVP         Boolean  @default(false)
  registrationDeadline DateTime @default(now())
  rsvpDeadline         DateTime @default(now())

  // Ticketing
  allowMultipleTickets Boolean   @default(false)
  salesStartDate       DateTime?
  salesEndDate         DateTime?

  // Relations
  tickets   Ticket[]
  orders    Order[]
  attendees User[]   @relation("EventAttendees")

  // Raffle
  isRaffle              Boolean   @default(false)
  raffleDrawDate        DateTime?
  raffleTerms           String?
  raffleTicketsPerOrder Int       @default(1)
  subtitle              String? // "Viva Las Vegas"
  tagline               String? // "Join Us For Our Send a Kid to Camp"
  address               String? // full street address
  website               String? // "www.bgcl.org"
  missionStatement      String?
  raffleTicketPrice     String? // "$100 Value" — display label
  raffleGrandPrizeLabel String? // "$10,000"
  raffleOddsLabel       String? // "1:50 chance"
  rafflePrizes          Json? // RafflePrize[]
  raffleSchedule        Json? // RaffleScheduleItem[]

  // ── Ticket sales window ────────────────────────────────────────
  ticketSalesStartDate DateTime?
  ticketSalesEndDate   DateTime?

  dressCodeHeadline String? // "Dress to Impress — or Just Have Fun!"
  dressCodeItems    Json? // Array of { label, description } for the bullet list
  dressCodeNote     String? // "(Per Venue: No jeans, t-shirts, or hats allowed.)"
  bestDressedPrizes String? // "Best Dressed Prizes will be awarded..."

  guestCount Int @default(0)

  showTicketMarquee       Boolean @default(true)
  showRaffleTicketNumbers Boolean @default(false)

  // deprecated
  featured Boolean @default(false)

  @@index([date])
  @@index([status])
  @@index([status, date])
  @@index([isPublic, status, date])
  @@index([category, date])
  @@index([type, date])
  @@index([requiresRSVP, registrationDeadline])
  @@index([ticketSalesStartDate])
  @@index([salesEndDate])
}

model Ticket {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Details
  name        String
  description String?
  price       Float

  // Inventory
  totalQuantity    Int
  quantitySold     Int @default(0)
  quantityReserved Int @default(0)

  sortOrder Int @default(0)

  // Relations
  eventId    String
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  ticketType     TicketType @default(GENERAL)
  isRaffleTicket Boolean    @default(false) // can derive from ticketType but keep for webhook convenience

  isPublished Boolean @default(false)

  sponsorImpact String? // "Covers 10 campers for the week..."
  sponsorPerks  String[] // ["Company logo on play money", "Admission for up to 10 guests"]

  guestCount Int @default(1)

  // Deprecated
  isAvailable Boolean @default(true)

  @@index([eventId])
  @@index([eventId, isPublished])
}

model Order {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Classification
  type   OrderType
  status OrderStatus @default(PENDING)

  // Financials
  totalAmount Float
  coverFees   Boolean @default(false)
  feesCovered Decimal @default(0) @db.Decimal(10, 2)

  // Payment processing
  paymentMethod   String?
  paymentMethodId String?
  paymentIntentId String?
  paidAt          DateTime?

  // Failure info
  failureReason String?
  failureCode   String?

  // Customer (denormalized for guest support)
  customerEmail  String
  customerName   String
  customerPhone  String?
  billingAddress Json?
  notes          String?

  // Recurring
  isRecurring          Boolean   @default(false)
  recurringFrequency   String?
  stripeSubscriptionId String?
  nextBillingDate      DateTime?

  // Relations
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  orderItems OrderItem[]

  // Tournament
  participatingInTournament Boolean @default(false)
  tournamentFeePaid         Float?

  attendingEvent Boolean @default(true)

  @@index([type])
  @@index([status])
  @@index([userId])
  @@index([eventId])
  @@index([customerEmail])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Pricing
  quantity     Int
  pricePerUnit Float
  totalPrice   Float

  // Denormalized ticket info (preserved if ticket is deleted)
  ticketName        String
  ticketDescription String?

  // Relations
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  raffleTicketNumber Int? // e.g. 247
  raffleTicketCode   String? @unique

  @@index([raffleTicketCode])
  @@index([orderId])
  @@index([ticketId])
}

model Campaign {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Basic Info
  name        String
  description String
  image       String?

  // Fundraising Goal
  goalAmount    Float
  currentAmount Float @default(0)

  // Campaign Details
  organizerName String
  startDate     DateTime
  endDate       DateTime?
  isActive      Boolean   @default(true)
  isListed      Boolean   @default(false)

  // External Links (for Harness transition)
  externalLink String?

  // Relations
  orders Order[]

  order Int @default(0)

  @@index([isActive])
  @@index([createdAt])
}

model Hero {
  id     String     @id @default(cuid())
  name   String
  status HeroStatus @default(DRAFT)

  // Content
  title    String @default("Welcome to Our Mission")
  subtitle String @default("Join us in making a difference")

  // Background — video or image, one at a time
  backgroundType  String @default("video") // video, image
  backgroundVideo String @default("")
  backgroundImage String @default("")
  overlayOpacity  Float  @default(0.5)

  // CTA Button 1
  cta1Text     String @default("Get Started")
  cta1Link     String @default("/")
  cta1LinkType String @default("internal") // internal, external

  // CTA Button 2
  cta2Text     String  @default("")
  cta2Link     String  @default("")
  cta2LinkType String  @default("internal") // internal, external
  showCta2     Boolean @default(false)

  // Announcement Strip
  showAnnouncement      Boolean @default(false)
  announcementText      String  @default("")
  announcementLinkLabel String  @default("")
  announcementLink      String  @default("")
  announcementLinkType  String  @default("internal")
  announcementColor1    String  @default("#0ea5e9") // sky-500
  announcementColor2    String  @default("#6366f1") // indigo-500

  // Countdown
  showCountdown  Boolean @default(false)
  countdownDate  String  @default("")
  countdownLabel String  @default("Event Starts In")

  // Thermometer Widget
  showThermometer    Boolean @default(false)
  thermometerGoal    Int     @default(100000)
  thermometerCurrent Int     @default(0)
  thermometerLabel   String  @default("Campaign Progress")
  thermometerColor   String  @default("#0ea5e9")

  // Growth Tree Widget
  showGrowthTree    Boolean @default(false)
  growthTreeCurrent Int     @default(0)
  growthTreeGoal    Int     @default(10000)
  growthTreeLabel   String  @default("Community Members")
  growthTreeColor   String  @default("#10b981")

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Program {
  id                String  @id @default(cuid())
  name              String
  descriptions      Json    @default("[]")
  image             String?
  imageTwo          String?
  ageGroup          String? // e.g., "5-10"
  showAgeGroup      Boolean @default(false)
  location          String? // e.g., "Boys & Girls Club of Lynn"
  frequency         String? // e.g., "Daily", "Weekly", "Per Session"
  dropOffStart      String? // e.g., "8:00am"
  dropOffEnd        String? // e.g., "9:00am"
  pickUpStart       String? // e.g., "4:00pm"
  pickUpEnd         String? // e.g., "4:30pm"
  datesAvailable    String? // e.g., "TBA", "June 1 - August 31"
  license           String? // e.g., "EEC Licensed Ages 5-10"
  order             Int     @default(0)
  additionalDetails Json
  showThemes        Boolean @default(false)
  themes            Json    @default("[]")
  externalLink      String? @default("")
  isListed          Boolean @default(false)
  pdfLink           String?
  pdfDescription    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Deprecated
  description1 String?
  description2 String?
  description3 String?
  description4 String?
  description5 String?
  heroImage    String?
}

model TeamMember {
  id      String  @id @default(cuid())
  name    String
  title   String?
  company String?
  image   String?
  bio     String?
  phone   String?
  email   String?
  role    String // 'board', 'staff', 'honoree', 'youth'
  order   Int     @default(0)

  // Youth of the Year fields (optional, only populated when role is 'youth')
  year       Int?
  paragraph1 String?
  paragraph2 String?
  paragraph3 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([year])
}

model Newsletter {
  id        String   @id @default(cuid())
  month     String // 'January', 'February', etc.
  year      Int // 2025, 2026, etc.
  pdfUrl    String // Google Drive link
  order     Int // for sorting
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, year])
  @@index([year])
}

model Resource {
  id    String @id @default(cuid())
  title String
  url   String
  order Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model News {
  id           String   @id @default(cuid())
  title        String
  image        String?
  paragraph1   String?
  paragraph2   String?
  paragraph3   String?
  externalLink String?  @default("")
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([title])
}

model Page {
  id        String  @id @default(cuid())
  slug      String  @unique
  content   Json
  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactSubmission {
  id        String                @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String
  subject   String?
  message   String?
  type      ContactSubmissionType
  status    ContactReadStatus     @default(NEW)

  // Availability
  availabilityDays  String? // "Monday,Wednesday,Friday" or JSON
  availabilityHours String? // "Morning" | "Afternoon" | "Evening" | "Flexible"

  // Interest & Experience
  programInterests String? // "KidsClub,TeenCenter,Sports" (comma-separated or JSON)
  yearsExperience  Int? // Optional

  // Legal/Info
  backgroundCheckAck Boolean? // Confirm they understand requirement
  additionalInfo     String? // Optional text field

  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model JobApplication {
  id String @id @default(cuid())

  // Personal Information
  applicantName  String         @db.VarChar(255)
  email          String         @unique @db.VarChar(255)
  employmentType EmploymentType
  hoursAvailable String         @db.Text
  languages      String         @db.VarChar(500)

  // References
  references Reference[]

  // Driving Information
  hasValidDriverLicense Boolean
  licenseNumber         String?   @db.VarChar(50)
  licenseExpiration     DateTime?
  noLicenseReason       String?   @db.Text
  licenseSuspended      Boolean   @default(false)
  suspensionExplanation String?   @db.Text
  trafficViolations     String?   @db.Text

  // Resume
  resumeUrl        String?   @db.VarChar(500)
  resumeFileName   String?   @db.VarChar(255)
  resumeFileSize   Int? // in bytes
  resumeUploadedAt DateTime?

  // Application Certification
  agreeToTerms           Boolean   @default(false)
  certifyInformation     Boolean   @default(false)
  authorizeBackground    Boolean   @default(false)
  understandActiveStatus Boolean   @default(false)
  signature              String?   @db.VarChar(255)
  signedAt               DateTime?

  // Application Status
  status           ApplicationStatus @default(PENDING)
  submissionStatus SubmissionStatus  @default(INCOMPLETE)

  youthOrgEmployment     String?        @db.Text
  education              String?        @db.Text
  extracurricularsSkills String?        @db.Text
  positionTypes          PositionType[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reference {
  id               String         @id @default(cuid())
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  jobApplicationId String

  // Reference Information
  name               String @db.Text
  positionAndCompany String @db.Text
  workRelationship   String @db.Text

  // Contact Information
  phone String @db.VarChar(20)
  email String @db.VarChar(255)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Theme {
  id    String @id @default(cuid())
  title String
  dates String // "6/22-6/26"
  order Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Closing {
  id        String   @id @default(cuid())
  title     String   @unique
  date      String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Partner {
  id           String           @id @default(cuid())
  name         String
  externalLink String?
  amount       String?
  image        String?
  description  String?
  isActive     Boolean?         @default(true)
  isFeatured   Boolean?         @default(false)
  category     PartnerCategory?
  notes        String?
  order        Int?             @default(0)
  tier         PartnerTier?

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

// ─── Address ───────────────────────────────────────────────────
model Address {
  id String @id @default(cuid())

  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  zipPostalCode String
  country       String  @default("US")

  isDefault Boolean     @default(false)
  type      AddressType @default(SHIPPING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, isDefault])
}

enum PartnerTier {
  FOUNDATION
  CORPORATE_BUSINESS
  GOVERNMENT_PUBLIC
  COMMUNITY_PROGRAM
}

enum PartnerCategory {
  CORPORATE
  NONPROFIT
  GOVERNMENT
  INDIVIDUAL
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  SEASONAL
}

enum ContactReadStatus {
  NEW
  READ
  ARCHIVED
}

enum ContactSubmissionType {
  VOLUNTEER
  GENERAL
}

enum ApplicationStatus {
  PENDING
  REVIEW
  APPROVED
  REJECTED
}

enum Role {
  STAFF
  VOLUNTEER
  ADMIN
  SUPERUSER
  SUPPORTER
  PROGRAM
}

enum HeroStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum NotificationType {
  APPLICATION_SUBMITTED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  NEW_MEMBER
  SYSTEM_ALERT
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
  POSTPONED
  ARCHIVED
}

enum EventType {
  IN_PERSON
  HYBRID
  VIRTUAL
}

enum OrderStatus {
  PENDING // Cart/checkout in progress
  PROCESSING // Payment being processed
  CONFIRMED // Payment successful
  CANCELLED // Order cancelled
  REFUNDED // Order refunded
  FAILED // Payment failed
  PENDING_CANCELLATION // Subscription will cancel at period end
}

enum OrderType {
  ONE_TIME_DONATION
  RECURRING_DONATION
  TICKET_PURCHASE
}

enum SubmissionStatus {
  INCOMPLETE
  COMPLETE
  SUBMITTED
}

enum PositionType {
  CAMP_COUNSELOR
  LIFEGUARD
  YOUTH_DEVELOPMENT_WORKER

  SEASONAL_SUMMER
}

enum TicketType {
  GENERAL
  RAFFLE
  TOURNAMENT
  SPONSORSHIP
}

enum AddressType {
  SHIPPING
  BILLING
}
