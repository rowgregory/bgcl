generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  role        Role
  lastLoginAt DateTime?

  // Generic person info (optional)
  firstName String?
  lastName  String?
  phone     String?

  emailVerified DateTime?

  // Staff-only fields (optional)
  position    String?
  department  String?
  hireDate    DateTime?
  staffStatus StaffStatus?

  // Flexible user-specific data
  metadata Json? // ← Future-proof

  stripeCustomerId String?
  paymentMethods   PaymentMethod[]
  accounts         Account[]
  sessions         Session[]
  orders           Order[]

  eventsAttended Event[] @relation("EventAttendees")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentMethod {
  id              String @id @default(cuid())
  stripePaymentId String @unique // stripe_pm_xxxxx

  cardBrand    String // visa, mastercard, etc
  cardLast4    String // 4242
  cardExpMonth Int
  cardExpYear  Int

  isDefault Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Subscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  type         String // 'member', 'non-member', 'donor'
  subscribedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Log {
  id        String   @id @default(cuid())
  level     String
  message   String
  metadata  Json?
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id                   String      @id @default(cuid())
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  title                String
  description          String?
  category             String
  capacity             Int         @default(200)
  attendeeCount        Int         @default(0)
  type                 EventType   @default(IN_PERSON)
  dresscode            String?
  date                 DateTime
  duration             String
  location             String
  maxAttendees         Int?
  status               EventStatus @default(UPCOMING)
  featured             Boolean     @default(false)
  host                 String?
  requirements         String?
  materials            String?
  registrationUrl      String?
  meetingUrl           String?
  isPublic             Boolean     @default(true)
  requiresRSVP         Boolean     @default(false)
  registrationDeadline DateTime    @default(now())
  rsvpDeadline         DateTime    @default(now())

  // Event-level settings
  allowMultipleTickets Boolean   @default(false) // Can user buy multiple ticket types
  salesStartDate       DateTime? // When tickets go on sale
  salesEndDate         DateTime? // When ticket sales close

  // Relations
  tickets   Ticket[] // ← NEW: One event has many ticket types
  orders    Order[] // ← NEW: One event has many orders
  attendees User[]   @relation("EventAttendees")

  @@index([date])
  @@index([status])
  @@index([status, date])
  @@index([featured, status, date])
  @@index([isPublic, status, date])
  @@index([category, date])
  @@index([type, date])
  @@index([requiresRSVP, registrationDeadline])
  @@index([salesStartDate])
  @@index([salesEndDate])
}

model Ticket {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ticket details
  name        String // e.g., "Table of 12", "VIP Seat", "General Admission"
  description String? // e.g., "Includes premium seating and dinner"
  price       Float // Price in cents or dollars (e.g., 180000 cents = $1800)

  // Inventory management
  totalQuantity    Int // Total available (e.g., 12 tables)
  quantitySold     Int @default(0) // How many sold
  quantityReserved Int @default(0) // How many in pending carts

  // Ticket availability
  isAvailable Boolean @default(true) // Can be toggled on/off

  // Ticket metadata
  sortOrder Int @default(0) // Display order in ticket selection

  // Relations
  eventId    String
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems OrderItem[] // ← Tickets purchased in orders

  @@index([eventId])
  @@index([eventId, isAvailable])
}

model Order {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Order details
  type   OrderType
  status OrderStatus @default(PENDING)

  // Payment
  totalAmount     Float // Total cost
  paymentMethod   String? // "stripe", "paypal", "cash", etc.
  paymentIntentId String? // Stripe payment intent ID
  paidAt          DateTime? // When payment was completed

  // Customer info (denormalized for easy access)
  customerEmail String
  customerName  String
  customerPhone String?

  // Billing info
  billingAddress Json? // Store as JSON
  coverFees      Boolean @default(false)
  feesCovered    Int     @default(0) // Amount in cents

  // Event info (only for ticket purchases)
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  // Campaign info (NEW)
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  // User info (nullable - guest checkout allowed)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Payment method
  paymentMethodId String? // stripe payment method ID used

  // Recurring donation fields
  stripeSubscriptionId String?   @unique // For recurring donations
  isRecurring          Boolean   @default(false)
  recurringFrequency   String? // "monthly", "yearly"
  nextBillingDate      DateTime? // Next charge date

  // Relations
  orderItems OrderItem[]

  @@index([type])
  @@index([status])
  @@index([eventId])
  @@index([userId])
  @@index([customerEmail])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Item details
  quantity     Int
  pricePerUnit Float // Price at time of purchase
  totalPrice   Float // quantity * pricePerUnit

  // Ticket info (denormalized for historical record)
  ticketName        String // Store name in case ticket is deleted
  ticketDescription String?

  // Relations
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  @@index([orderId])
  @@index([ticketId])
}

model Campaign {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Basic Info
  name        String
  description String
  image       String?

  // Fundraising Goal
  goalAmount    Float
  currentAmount Float @default(0)

  // Campaign Details
  organizerName String
  startDate     DateTime
  endDate       DateTime?
  isActive      Boolean   @default(true)

  // External Links (for Harness transition)
  externalLink String?

  // Relations
  orders Order[]

  order Int @default(0)

  @@index([isActive])
  @@index([createdAt])
}

model Hero {
  id     String     @id @default(cuid())
  name   String
  status HeroStatus @default(DRAFT)

  // Layout & Height
  minHeight    String @default("screen") // screen, half, full
  actualHeight String @default("100vh")

  // Background
  backgroundType     String @default("gradient") // color, gradient, image, video
  backgroundColor    String @default("#0a0a0a")
  gradientFrom       String @default("#1e1b4b")
  gradientTo         String @default("#0f172a")
  backgroundImage    String @default("")
  backgroundVideo    String @default("")
  backgroundSize     String @default("cover") // cover, contain, auto
  backgroundPosition String @default("center") // center, top, bottom, left, right, top-left, top-right, bottom-left, bottom-right
  overlayOpacity     Float  @default(0.5)

  // Content
  title              String  @default("Welcome to Our Mission")
  titleColor         String  @default("#ffffff")
  titleGradientWord  String  @default("") // Word to gradient
  titleGradientFrom  String  @default("#6366f1") // Gradient start
  titleGradientTo    String  @default("#ec4899") // Gradient end
  titleUseGradient   Boolean @default(false) // Enable gradient
  titleLineHeight    String  @default("1.2")
  titleFontSize      String  @default("4rem")
  subtitle           String  @default("Join us in making a difference")
  subtitleColor      String  @default("#a3a3a3")
  subtitleLineHeight String  @default("1.5")
  subtitleFontSize   String  @default("1.5rem")

  // Animations
  titleAnimation          String @default("fade-up") // fade-up, fade-down, fade-left, fade-right, scale, bounce, none
  subtitleAnimation       String @default("fade-up")
  ctaAnimation            String @default("fade-up")
  floatingButtonAnimation String @default("pulse") // pulse, bounce, shake, none

  // Layout
  layout String @default("side-by-side") // side-by-side, stacked-center, stacked-left, stacked-right

  // CTA Button
  ctaText            String @default("Get Started")
  ctaLink            String @default("/")
  ctaBackgroundColor String @default("#6366f1")
  ctaTextColor       String @default("#ffffff")
  ctaBorderRadius    String @default("50")

  // Thermometer Widget
  showThermometer     Boolean @default(false)
  thermometerGoal     Int     @default(100000)
  thermometerCurrent  Int     @default(45000)
  thermometerColor    String  @default("#6366f1")
  thermometerPosition String  @default("right") // left, center, right

  // Countdown Widget
  showCountdown     Boolean @default(false)
  countdownDate     String  @default("2025-12-31")
  countdownLabel    String  @default("Event Starts In")
  countdownPosition String  @default("right") // left, center, right
  countdownColor    String  @default("#6366f1")

  // Growth Tree Widget
  showGrowthTree     Boolean @default(false)
  growthTreeCurrent  Int     @default(8234)
  growthTreeGoal     Int     @default(10000)
  growthTreeLabel    String  @default("Community Members")
  growthTreePosition String  @default("right") // left, center, right
  growthTreeColor    String  @default("#10b981")

  // Floating Button
  showFloatingButton         Boolean @default(false)
  floatingButtonText         String  @default("Get Help")
  floatingButtonPosition     String  @default("bottom-right") // top-left, top-right, bottom-left, bottom-right
  floatingButtonBgColor      String  @default("#6366f1")
  floatingButtonTextColor    String  @default("#ffffff")
  floatingButtonBorderRadius String  @default("50")
  floatingButtonAction       String  @default("modal") // internal, external, modal, drawer
  floatingButtonLink         String  @default("/contact")
  floatingButtonIcon         String  @default("chat") // none, arrow, phone, email, chat, info, help

  // Top Banner
  showTopBanner      Boolean @default(false)
  topBannerText      String  @default("Click here to learn about our Capital Campaign")
  topBannerHeight    String  @default("40")
  topBannerBgColor   String  @default("#6366f1")
  topBannerTextColor String  @default("#ffffff")
  topBannerFontSize  String  @default("0.875")
  topBannerBold      Boolean @default(false)
  topBannerLinkType  String  @default("none") // none, internal, external
  topBannerLink      String  @default("")

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
}

model Program {
  id                String  @id @default(cuid())
  name              String
  description1      String // About what kids do and program details
  description2      String?
  description3      String?
  description4      String?
  description5      String?
  image             String?
  heroImage         String?
  ageGroup          String? // e.g., "5-10"
  showAgeGroup      Boolean @default(false)
  location          String? // e.g., "Boys & Girls Club of Lynn"
  frequency         String? // e.g., "Daily", "Weekly", "Per Session"
  dropOffStart      String? // e.g., "8:00am"
  dropOffEnd        String? // e.g., "9:00am"
  pickUpStart       String? // e.g., "4:00pm"
  pickUpEnd         String? // e.g., "4:30pm"
  datesAvailable    String? // e.g., "TBA", "June 1 - August 31"
  license           String? // e.g., "EEC Licensed Ages 5-10"
  order             Int     @default(0)
  additionalDetails Json

  themes Theme[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id      String  @id @default(cuid())
  name    String
  title   String?
  company String?
  image   String?
  bio     String?
  phone   String?
  email   String?
  role    String // 'board', 'staff', 'honoree', 'youth'
  order   Int     @default(0)

  // Youth of the Year fields (optional, only populated when role is 'youth')
  year       Int?
  paragraph1 String?
  paragraph2 String?
  paragraph3 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([year])
}

model Newsletter {
  id        String   @id @default(cuid())
  month     String // 'January', 'February', etc.
  year      Int // 2025, 2026, etc.
  pdfUrl    String // Google Drive link
  order     Int // for sorting
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, year])
  @@index([year])
}

model Resource {
  id    String @id @default(cuid())
  title String
  url   String
  order Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model News {
  id         String   @id @default(cuid())
  title      String
  image      String?
  paragraph1 String?
  paragraph2 String?
  paragraph3 String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([title])
}

model Page {
  id        String  @id @default(cuid())
  slug      String  @unique
  content   Json
  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactSubmission {
  id        String                @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String
  subject   String?
  message   String?
  type      ContactSubmissionType
  status    ContactReadStatus     @default(NEW)

  // Availability
  availabilityDays  String? // "Monday,Wednesday,Friday" or JSON
  availabilityHours String? // "Morning" | "Afternoon" | "Evening" | "Flexible"

  // Interest & Experience
  programInterests String? // "KidsClub,TeenCenter,Sports" (comma-separated or JSON)
  yearsExperience  Int? // Optional

  // Legal/Info
  backgroundCheckAck Boolean? // Confirm they understand requirement
  additionalInfo     String? // Optional text field

  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model JobApplication {
  id String @id @default(cuid())

  // Personal Information
  applicantName  String         @db.VarChar(255)
  email          String         @unique @db.VarChar(255)
  employmentType EmploymentType
  hoursAvailable String         @db.Text
  languages      String         @db.VarChar(500)

  // References
  references Reference[]

  // Driving Information
  hasValidDriverLicense Boolean
  licenseNumber         String?   @db.VarChar(50)
  licenseExpiration     DateTime?
  noLicenseReason       String?   @db.Text
  licenseSuspended      Boolean   @default(false)
  suspensionExplanation String?   @db.Text
  trafficViolations     String?   @db.Text

  // Resume
  resumeUrl        String?   @db.VarChar(500)
  resumeFileName   String?   @db.VarChar(255)
  resumeFileSize   Int? // in bytes
  resumeUploadedAt DateTime?

  // Application Certification
  agreeToTerms           Boolean   @default(false)
  certifyInformation     Boolean   @default(false)
  authorizeBackground    Boolean   @default(false)
  understandActiveStatus Boolean   @default(false)
  signature              String?   @db.VarChar(255)
  signedAt               DateTime?

  // Application Status
  status           ApplicationStatus @default(PENDING)
  submissionStatus SubmissionStatus  @default(INCOMPLETE)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reference {
  id               String         @id @default(cuid())
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  jobApplicationId String

  // Reference Information
  name               String @db.VarChar(255)
  positionAndCompany String @db.VarChar(500)
  workRelationship   String @db.VarChar(255)

  // Contact Information
  phone String @db.VarChar(20)
  email String @db.VarChar(255)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Theme {
  id        String  @id @default(cuid())
  title     String
  dates     String // "6/22-6/26"
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  order     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([programId, order]) // prevent duplicate weeks per program
  @@index([programId])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  SEASONAL
}

enum ContactReadStatus {
  NEW
  READ
  ARCHIVED
}

enum ContactSubmissionType {
  VOLUNTEER
  GENERAL
}

enum ApplicationStatus {
  PENDING
  REVIEW
  APPROVED
  REJECTED
}

enum Role {
  STAFF
  VOLUNTEER
  ADMIN
  SUPERUSER
  SUPPORTER
}

enum HeroStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum NotificationType {
  APPLICATION_SUBMITTED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  NEW_MEMBER
  SYSTEM_ALERT
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
  POSTPONED
}

enum EventType {
  IN_PERSON
  HYBRID
  VIRTUAL
}

enum OrderStatus {
  PENDING // Cart/checkout in progress
  PROCESSING // Payment being processed
  CONFIRMED // Payment successful
  CANCELLED // Order cancelled
  REFUNDED // Order refunded
  FAILED // Payment failed
}

enum OrderType {
  ONE_TIME_DONATION
  RECURRING_DONATION
  TICKET_PURCHASE
}

enum SubmissionStatus {
  INCOMPLETE
  COMPLETE
  SUBMITTED
}
